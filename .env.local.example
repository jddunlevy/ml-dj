# Copy to .env.local and fill in. .env.local is gitignored; this repo is public.

# Spotify app: https://developer.spotify.com/dashboard
# Redirect URI must be exactly http://127.0.0.1:8888/callback
# The account needs Premium. An existing client ID can be reused from cd-player.
SPOTIFY_CLIENT_ID=

# Last.fm API account: https://www.last.fm/api/account/create
LASTFM_API_KEY=
LASTFM_USER=
